    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^6.0.4",
    "deno": "^2.9.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
